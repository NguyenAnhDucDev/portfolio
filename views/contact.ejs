<div class="contact-container">
  <h1 class="contact-title"><%= lang.contactTitle || 'Contact' %></h1>
  <% if (langCode === 'vi') { %>
    <p class="contact-note text-info mb-3" style="font-size:1.08em;">Bạn là nhà tuyển dụng hoặc muốn hợp tác? Hãy liên hệ với tôi về vị trí Business Analyst hoặc Backend/Software Engineer!</p>
  <% } else { %>
    <p class="contact-note text-info mb-3" style="font-size:1.08em;">Are you a recruiter or want to collaborate? Contact me for Business Analyst or Backend/Software Engineer positions!</p>
  <% } %>
  <form id="contactForm" class="contact-form" autocomplete="off" enctype="multipart/form-data">
    <div class="input-group">
      <span class="input-icon"><i class="fas fa-user"></i></span>
      <input type="text" name="name" placeholder="<%= lang.yourName || 'Your Name' %>" required>
    </div>
    <div class="input-group">
      <span class="input-icon"><i class="fas fa-envelope"></i></span>
      <input type="email" name="email" placeholder="<%= lang.yourEmail || 'Your Email' %>" required>
    </div>
    <div class="input-group">
      <span class="input-icon"><i class="fas fa-phone"></i></span>
      <input type="tel" name="phone" placeholder="Phone Number" required>
    </div>
    <div class="input-group textarea-group">
      <span class="input-icon"><i class="fas fa-comment-dots"></i></span>
      <textarea name="message" placeholder="<%= lang.yourMessage || 'Your Message' %>" required></textarea>
    </div>
    <div class="input-group file-upload-group" id="dragDropJD" style="position:relative;min-height:140px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(0,234,255,0.04);border-radius:12px 12px 0 0;cursor:pointer;overflow:hidden;">
      <input type="file" name="jdFile" id="jdFile" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.png,.jpg,.jpeg" style="position:absolute;left:0;top:0;width:100%;height:100%;opacity:0;cursor:pointer;z-index:2;">
      <i class="fas fa-cloud-upload-alt" style="font-size:2.2em;color:#00eaff;margin-bottom:12px;z-index:1;"></i>
      <span style="color:#bfc9d1;font-size:1.13em;text-align:center;z-index:1;">Drag and drop JD here or click to select file</span>
      <div id="fileName" class="file-name" style="margin-top:10px;z-index:1;"></div>
    </div>
    <button type="submit" id="sendBtn" class="send-btn"><%= lang.send || 'Send' %></button>
    <div id="formStatus" class="form-status"></div>
  </form>
  <div class="contact-socials">
    <a href="https://github.com/<%= profile.contact.github %>" target="_blank" class="social-icon" title="GitHub"><i class="fab fa-github"></i></a>
    <a href="<%= profile.contact.facebook %>" target="_blank" class="social-icon" title="Facebook"><i class="fab fa-facebook"></i></a>
  </div>
</div>

<style>
.file-upload-group {
  margin: 20px 0 0 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0;
}

.file-upload-container {
  position: relative;
  left: 24px;
  width: calc(100% - 36px);
  box-sizing: border-box;
  /* border: 2px dashed #00eaff; */
  border-radius: 12px 12px 0 0;
  padding: 28px 0;
  background: rgba(0,234,255,0.04);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120px;
  margin-top: -12px;
}

.file-input {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  opacity: 0;
  cursor: pointer;
}

.file-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  font-size: 1.15em;
  background: none;
  border: none;
  box-shadow: none;
  padding: 0;
  margin: 0;
  cursor: pointer;
  height: 100%;
}

.file-label:hover {
  background: none;
}

.file-label i {
  font-size: 2.2em;
  color: #00eaff;
  margin-bottom: 12px;
}

.file-label span {
  color: #bfc9d1;
  font-size: 1.13em;
  text-align: center;
}

.file-name {
  margin-top: 10px;
  color: #00fff7;
  font-size: 1em;
  text-align: center;
}

.form-status {
  margin-top: 15px;
  padding: 10px;
  border-radius: 8px;
  text-align: center;
}

.form-status.success {
  background: rgba(0,255,0,0.1);
  color: #00ff00;
}

.form-status.error {
  background: rgba(255,0,0,0.1);
  color: #ff0000;
}
</style> 