<h2 class="fw-bold mb-4 text-white"><%= langCode === 'vi' ? 'Dự án' : 'Projects' %></h2>
<div class="row g-4">
  <% profile.projects.forEach(function(project) { %>
    <div class="col-md-6 d-flex">
      <div class="project-card d-flex flex-column p-4 rounded shadow-sm w-100">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <h5 class="fw-bold mb-0 project-title"><%= project.title[langCode] %></h5>
          <span class="text-white small ms-2"><%= project.year %></span>
        </div>
        <div class="mb-2" style="color:#bfc9d1; min-height:60px;">
          <%= project.description[langCode] %>
        </div>
        <% if (project.roleBA || project.roleBackend) { %>
          <div class="mb-2" style="font-size:0.98em; color:#00fff7;">
            <% if (langCode === 'vi') { %>
              <% if (project.roleBA) { %><div><b>Vai trò BA:</b> <%= project.roleBA.vi %></div><% } %>
              <% if (project.roleBackend) { %><div><b>Vai trò Backend:</b> <%= project.roleBackend.vi %></div><% } %>
            <% } else { %>
              <% if (project.roleBA) { %><div><b>BA Role:</b> <%= project.roleBA.en %></div><% } %>
              <% if (project.roleBackend) { %><div><b>Backend Role:</b> <%= project.roleBackend.en %></div><% } %>
            <% } %>
          </div>
        <% } %>
        <% if (project.techs) { %>
          <div class="mb-2">
            <% project.techs.forEach(function(tech) { %>
              <span class="badge bg-info text-dark me-1 mb-1"><%= tech %></span>
            <% }); %>
          </div>
        <% } %>
        <div class="mt-auto pt-2">
          <a href="<%= project.link %>" target="_blank" class="btn btn-outline-info w-100 fw-bold">
            <i class="fab fa-github me-1"></i> <%= langCode === 'vi' ? 'Xem GitHub' : 'View on GitHub' %>
          </a>
        </div>
      </div>
    </div>
  <% }); %>
</div> 